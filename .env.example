# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=false

# Postgres
DATABASE_URL=postgresql://chatsim_dev:chatsim_dev@127.0.0.1:54339/chatsim_dev
TEST_DATABASE_URL=postgresql://chatsim_dev:chatsim_dev@127.0.0.1:54339/chatsim_test

# Cloudflare R2. Use separate bucket-scoped credentials for each bucket.
R2_ACCOUNT_ID=
R2_ORIGINALS_BUCKET=philippeho-chatsim-originals
R2_ORIGINALS_ACCESS_KEY_ID=
R2_ORIGINALS_SECRET_ACCESS_KEY=
R2_VARIANTS_BUCKET=philippeho-chatsim-variants
R2_VARIANTS_ACCESS_KEY_ID=
R2_VARIANTS_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.chatsim.philippeho.dev

# One-time production bootstrap. Remove these after the first admin is created.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME=Chatsim Admin
