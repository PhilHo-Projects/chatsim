{
  "name": "scripted-texting-animation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx server/index.ts",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d --wait postgres",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d --wait postgres",
    "db:migrate": "tsx server/db/cli.ts migrate",
    "db:seed": "tsx server/db/cli.ts seed",
    "db:bootstrap-admin": "tsx server/db/cli.ts bootstrap-admin",
    "media:extract-legacy": "tsx server/extractLegacyDataUrls.ts",
    "media:extract-legacy:apply": "tsx server/extractLegacyDataUrls.ts --apply",
    "build": "tsc -b && vite build && node scripts/compressDist.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "start:api": "tsx server/index.ts",
    "test": "vitest run",
    "test:db": "npm run dev:db && vitest run server",
    "test:watch": "vitest",
    "assets:optimize": "tsx scripts/optimizeAssets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "better-auth": "1.7.2",
    "lucide-react": "^1.60.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "6.34.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.8"
  }
}
