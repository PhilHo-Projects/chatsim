{
  "name": "scripted-texting-animation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx server/index.ts",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d --wait postgres",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d --wait postgres",
    "db:migrate": "tsx server/db/cli.ts migrate",
    "db:seed": "tsx server/db/cli.ts seed",
    "db:bootstrap-admin": "tsx server/db/cli.ts bootstrap-admin",
    "build": "tsc -b && vite build",
    "build:chatsim": "tsc -b && vite build --base=/chatsim/",
    "preview": "vite preview --host 127.0.0.1",
    "start:api": "tsx server/index.ts",
    "test": "vitest run",
    "test:db": "npm run dev:db && vitest run server",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "lucide-react": "^1.17.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
